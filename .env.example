# Copy to .env and fill in. Every value here is checked when the process starts:
# if one is missing, malformed, or still a placeholder, the bot refuses to boot.
# A server that will not start is a much cheaper failure than a bot that starts
# and misbehaves in front of a teacher.
#
#   cp .env.example .env
#
# .env is gitignored and must never be committed.

NODE_ENV=development
LOG_LEVEL=info

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Holds every record, every in-progress conversation, and the job queue.
# With docker compose, the host is the service name "postgres".
DATABASE_URL=postgres://mopse:change-me-locally@localhost:5432/mopse

# ---------------------------------------------------------------------------
# Telegram
# ---------------------------------------------------------------------------
# From @BotFather. Anyone holding this can impersonate the bot to every teacher
# on the roster — treat it exactly like a password.
TELEGRAM_BOT_TOKEN=

# Sent by Telegram in the X-Telegram-Bot-Api-Secret-Token header on every
# webhook call. The Apps Script version kept this in the URL's query string,
# where it leaked into proxy logs and browser history.
#
# Generate it, do not invent it:
#   openssl rand -hex 32
#
# Telegram accepts A-Z a-z 0-9 _ - only, 1-256 characters. We require 32+.
TELEGRAM_WEBHOOK_SECRET=

# The public HTTPS origin Telegram posts to. No trailing slash, no path.
# Caddy obtains and renews the certificate for this hostname automatically.
PUBLIC_URL=https://bot.example.uz

# Port the web process listens on behind Caddy. Not exposed publicly.
PORT=8080

# Telegram chat id that receives operational alarms — a refused sync, a rejected
# FAQ row, a scheduled job that stopped running, a duplicate identity binding.
#
# Required in production. Duplicate identity bindings are detected rather than
# blocked, deliberately, which makes that alarm the only impersonation control
# there is; an alarm nobody receives is the same as no alarm. Until staff
# management exists this is the only way anything reaches a person.
#
# Message @userinfobot from the account or group that should receive these.
# Numeric id only — the Bot API cannot reliably message an @username.
OPS_ALERT_CHAT_ID=

# ---------------------------------------------------------------------------
# MoPSE settings
# ---------------------------------------------------------------------------
# A real support email or phone. Shown to any teacher the roster does not
# recognise, and to anyone asking what is held about them or asking for it to be
# removed. The Apps Script version shipped a literal placeholder here and the
# runbook listed replacing it as a pre-launch blocker, where it stayed. Anything
# containing the word PLACEHOLDER is now rejected at start-up.
SUPPORT_CONTACT=

# ---------------------------------------------------------------------------
# Google Sheets (read-only)
# ---------------------------------------------------------------------------
# The spreadsheet owns what the bot only reads: the FAQ answers and the teacher
# roster. Everything the bot writes lives in PostgreSQL. Information flows one
# way, so there is never a question about which copy is correct.
#
# Grant the service account Viewer on that one spreadsheet and nothing else.
# The bot never writes to Sheets, so Editor access would only add risk.
GOOGLE_SHEET_ID=
# The service-account key, as one line of JSON.
GOOGLE_SERVICE_ACCOUNT_JSON=

# ---------------------------------------------------------------------------
# Backups — see deploy/README.md
# ---------------------------------------------------------------------------
# Nightly encrypted dump pushed off the server. A rented server with no off-site
# backup is the same single-point-of-failure as the single Google account was,
# wearing a different hat. Required before launch, not after.
# The backup runs from the HOST, out of cron — not inside a container. It
# therefore cannot use DATABASE_URL above, because the hostname there is the
# compose service name and only resolves inside the compose network. Postgres is
# published on loopback for exactly this purpose.
#
# Same credentials, different host. The script refuses to start without it.
BACKUP_DATABASE_URL=postgres://mopse:change-me-locally@127.0.0.1:5432/mopse

BACKUP_PASSPHRASE=
BACKUP_REMOTE=
