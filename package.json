{
  "name": "mopse-teacher-support-bot",
  "version": "0.1.0",
  "private": true,
  "description": "Telegram support bot for teachers recruited by the Ministry of Preschool and School Education, Uzbekistan",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "dev:web": "tsx watch src/web/main.ts",
    "dev:worker": "tsx watch src/worker/main.ts",
    "start:web": "node dist/web/main.js",
    "start:worker": "node dist/worker/main.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "lint": "oxlint --type-aware --deny-warnings src",
    "knip": "node --max-old-space-size=4096 node_modules/knip/bin/knip.js",
    "knip:prod": "node --max-old-space-size=4096 node_modules/knip/bin/knip.js --production",
    "deps": "node scripts/dependency-tree.mjs > docs/dependency-tree.md",
    "deps:check": "node scripts/dependency-tree.mjs --check",
    "sync": "tsx src/scripts/sync-sheets.ts",
    "set-webhook": "tsx src/scripts/set-webhook.ts"
  },
  "dependencies": {
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "google-auth-library": "^10.9.1",
    "grammy": "^1.45.1",
    "graphile-worker": "^0.17.3",
    "pg": "^8.22.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "@types/pg": "^8.20.0",
    "drizzle-kit": "^0.31.10",
    "knip": "^6.29.0",
    "oxlint": "^1.76.0",
    "oxlint-tsgolint": "^7.0.2001",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
