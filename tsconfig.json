{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "outDir": "dist",
    "sourceMap": true,
    "declaration": false,
    /* This config is for the editor, vitest and typechecking — it covers the
       root-level config files too, which are not part of the shipped build.
       tsconfig.build.json turns emit back on for src/ alone. */
    "noEmit": true,

    /* Strictness. The point of TypeScript here is that a spreadsheet column
       rename, a missing case field or an unhandled Telegram failure stops the
       build instead of silently killing a feature at runtime — which is exactly
       how the Apps Script version failed. That only works if these stay on. */
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "exactOptionalPropertyTypes": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,

    "verbatimModuleSyntax": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "resolveJsonModule": true
  },
  "include": ["src/**/*.ts", "*.config.ts", "drizzle.config.ts"],
  "exclude": ["node_modules", "dist"]
}
